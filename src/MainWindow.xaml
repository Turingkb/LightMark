<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F9FB" TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#263348">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#3F4F63"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#E6EFED"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#28766D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#DDE4EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ToggleButton x:Name="Expander" Width="16" Height="24" Margin="0,4,0,0" VerticalAlignment="Top" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="展开或折叠子标题">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 4 L 0 8 Z" Fill="#78899A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" CenterX="2.5" CenterY="4"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Border x:Name="HeaderBorder" Grid.Column="1" Padding="5,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"><ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
          <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#DFEEEA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#28766D"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" Background="#F7F9FB" Padding="8,2">
    <MenuItem Header="文件(_F)">
      <MenuItem x:Name="NewMenu" Header="新建" InputGestureText="Ctrl+N"/><MenuItem x:Name="OpenMenu" Header="打开…" InputGestureText="Ctrl+O"/><MenuItem x:Name="RecentMenu" Header="最近打开"/><Separator/>
      <MenuItem x:Name="SaveMenu" Header="保存" InputGestureText="Ctrl+S"/><MenuItem x:Name="SaveAsMenu" Header="另存为…" InputGestureText="Ctrl+Shift+S"/><Separator/>
      <MenuItem x:Name="RecoveryMenu" Header="恢复未保存的草稿…"/><MenuItem x:Name="FolderMenu" Header="在资源管理器中显示"/><Separator/>
      <MenuItem x:Name="RegisterMenu" Header="注册为 Markdown 打开方式…"/><MenuItem x:Name="DefaultMenu" Header="打开 Windows 默认应用设置"/><Separator/><MenuItem x:Name="ExitMenu" Header="退出"/>
    </MenuItem>
    <MenuItem Header="编辑(_E)"><MenuItem x:Name="UndoMenu" Header="撤销" InputGestureText="Ctrl+Z"/><MenuItem x:Name="RedoMenu" Header="重做" InputGestureText="Ctrl+Y"/><Separator/><MenuItem x:Name="FindMenu" Header="查找" InputGestureText="Ctrl+F"/><MenuItem x:Name="ReplaceMenu" Header="替换" InputGestureText="Ctrl+H"/><Separator/><MenuItem x:Name="BoldMenu" Header="加粗" InputGestureText="Ctrl+B"/><MenuItem x:Name="ItalicMenu" Header="斜体" InputGestureText="Ctrl+I"/><MenuItem x:Name="LinkMenu" Header="插入链接" InputGestureText="Ctrl+K"/></MenuItem>
    <MenuItem Header="视图(_V)"><MenuItem x:Name="EditMenu" Header="仅编辑" InputGestureText="Ctrl+1"/><MenuItem x:Name="SplitMenu" Header="编辑与预览" InputGestureText="Ctrl+2"/><MenuItem x:Name="ReadMenu" Header="仅预览" InputGestureText="Ctrl+3"/><Separator/><MenuItem x:Name="OutlineMenu" Header="显示目录" IsCheckable="True" IsChecked="True"/><MenuItem x:Name="WrapMenu" Header="源码自动换行" IsCheckable="True" IsChecked="True"/><MenuItem x:Name="SyncMenu" Header="滚动同步" IsCheckable="True" IsChecked="True"/><Separator/><MenuItem x:Name="ZoomInMenu" Header="放大文字" InputGestureText="Ctrl++"/><MenuItem x:Name="ZoomOutMenu" Header="缩小文字" InputGestureText="Ctrl+-"/></MenuItem>
    <MenuItem Header="帮助(_H)"><MenuItem x:Name="WelcomeMenu" Header="打开使用指南"/><MenuItem x:Name="LicensesMenu" Header="第三方许可证"/><MenuItem x:Name="AboutMenu" Header="关于 LightMark"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" Background="White" BorderBrush="#E2E8EF" BorderThickness="0,0,0,1">
    <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#28766D" CornerRadius="7" Width="34" Height="34"><TextBlock Text="M↓" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,25,0"><TextBlock Text="LightMark" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="轻一点，写下来。" FontSize="10" Foreground="#7E8A9B"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenButton" Content="打开" ToolTip="打开 Markdown 文件 (Ctrl+O)"/><Button x:Name="SaveButton" Content="保存" Background="#E5F1ED" Foreground="#216C62" ToolTip="保存 (Ctrl+S)"/><StackPanel x:Name="FormattingTools" Orientation="Horizontal"><Border Background="#E4E9EF" Width="1" Height="20" Margin="14,0"/><Button x:Name="BoldButton" Content="B" FontWeight="Bold" ToolTip="加粗 (Ctrl+B)"/><Button x:Name="CodeButton" Content="&lt;/&gt;" FontFamily="Consolas" ToolTip="行内代码 / 代码块"/><Button x:Name="LinkButton" Content="链接" ToolTip="插入链接 (Ctrl+K)"/></StackPanel></StackPanel>
      <Border Grid.Column="2" Background="#F0F3F6" CornerRadius="6" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="EditButton" Content="编辑" Padding="12,6" ToolTip="Ctrl+1"/><Button x:Name="SplitButton" Content="分栏" Padding="12,6" ToolTip="Ctrl+2"/><Button x:Name="ReadButton" Content="阅读" Padding="12,6" ToolTip="Ctrl+3"/></StackPanel></Border>
    </Grid>
  </Border>
  <Border Grid.Row="2" x:Name="FindBar" Visibility="Collapsed" Background="#EFF4F5" Padding="16,9" BorderBrush="#DEE7EA" BorderThickness="0,0,0,1">
    <StackPanel><StackPanel Orientation="Horizontal"><TextBox x:Name="FindText" Width="235" AutomationProperties.Name="查找内容" ToolTip="输入查找文字，Enter 查找下一个"/><CheckBox x:Name="MatchCase" Content="区分大小写" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="FindPrevious" Content="上一个"/><Button x:Name="FindNext" Content="下一个"/><Button x:Name="CloseFind" Content="关闭" ToolTip="Esc"/><TextBlock x:Name="FindInfo" VerticalAlignment="Center" Foreground="#66768B" Margin="8,0"/></StackPanel>
    <StackPanel x:Name="ReplaceBar" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed"><TextBox x:Name="ReplaceText" Width="235" AutomationProperties.Name="替换内容"/><Button x:Name="ReplaceOne" Content="替换当前"/><Button x:Name="ReplaceAll" Content="全部替换"/></StackPanel></StackPanel>
  </Border>
  <Grid Grid.Row="3" x:Name="Workspace">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="OutlineColumn" Width="248"/><ColumnDefinition x:Name="EditorColumn" Width="*"/><ColumnDefinition x:Name="DividerColumn" Width="5"/><ColumnDefinition x:Name="PreviewColumn" Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" BorderBrush="#E1E7EE" BorderThickness="0,0,1,0" Background="#F6F8FA">
      <DockPanel Margin="12,20,12,10"><StackPanel DockPanel.Dock="Top"><TextBlock Text="文档目录" FontWeight="SemiBold" Foreground="#68788D" FontSize="11" Margin="9,0,0,16"/><TextBlock x:Name="FileLabel" Text="未命名.md" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Margin="9,0,9,14"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="本地文件 · 离线预览" Foreground="#8794A5" FontSize="10" Margin="9,10,0,2"/><TreeView x:Name="OutlineTree" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="文档分级目录"/></DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="EditorPane" Background="#FAFBFD"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#E5EBF1" BorderThickness="0,0,0,1" Padding="20,10,12,6"><DockPanel><TextBlock Text="MARKDOWN" FontSize="10" FontWeight="SemiBold" Foreground="#75849A"/><TextBlock x:Name="DirtyLabel" Text="已保存" HorizontalAlignment="Right" FontSize="10" Foreground="#8190A1"/></DockPanel></Border>
      <TextBox Grid.Row="1" x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="15" Padding="22,18,22,28" BorderThickness="0" Background="#FAFBFD" VerticalContentAlignment="Top" UndoLimit="100" SpellCheck.IsEnabled="False" AutomationProperties.Name="Markdown 源码编辑器"/>
    </Grid>
    <GridSplitter x:Name="Divider" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="#E6EBF1" ResizeDirection="Columns"/>
    <Grid Grid.Column="3" x:Name="PreviewPane" Background="White"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#E5EBF1" BorderThickness="0,0,0,1" Padding="24,10,12,6"><TextBlock Text="即时预览" FontSize="10" FontWeight="SemiBold" Foreground="#75849A"/></Border><FlowDocumentScrollViewer Grid.Row="1" x:Name="Preview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" IsSelectionEnabled="True" AutomationProperties.Name="Markdown 即时预览"/></Grid>
  </Grid>
  <Border Grid.Row="4" BorderBrush="#DDE5ED" BorderThickness="0,1,0,0" Background="#F3F6F8" Padding="17,0"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Message" Text="就绪" Foreground="#68788D" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Grid.Column="1" x:Name="Statistics" Text="" HorizontalAlignment="Right" Foreground="#68788D" FontSize="11"/></Grid></Border>
</Grid>
